PORT=3000
HOST=0.0.0.0
# Optional: comma-separated exact browser origins when frontend and backend are hosted separately.
ALLOWED_ORIGINS=
# Optional override for the public Deriv market-data WebSocket endpoint.
DERIV_WS_URL=wss://api.derivws.com/trading/v1/options/ws/public

# No trading token is required for public market data.
# If authenticated trading is implemented in a future stage, secrets must be stored
# as backend environment variables only and must never be added to frontend files.
